@model IEnumerable<ReFound.Models.FoundItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<!-- Live Search Input Box -->
<input type="text" id="foundSearchBox" class="form-control mb-3"
       placeholder="Live search found items..." />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ItemName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateFound)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocationFound)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="foundItemRows">
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ItemName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateFound)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocationFound)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
<script>
    document.getElementById("foundSearchBox").addEventListener("input", function () {
        const text = this.value.toLowerCase();

        document.querySelectorAll("#foundItemRows tr").forEach(function (row) {
            // Checks ItemName (cell 0), Description (cell 1), Category (cell 2), and LocationFound (cell 4)
            const rowText = (row.cells[0].textContent + " " +
                             row.cells[1].textContent + " " +
                             row.cells[2].textContent + " " +
                             row.cells[4].textContent).toLowerCase();

            row.style.display = rowText.includes(text) ? "" : "none";
        });
    });
</script>
}