@model ReFound.Models.LostItemReport

@{
    ViewData["Title"] = "Lost Item Details";
    var potentialMatches = ViewBag.PotentialMatches as List<ReFound.Models.FoundItem> ?? new List<ReFound.Models.FoundItem>();
}

<h1>Lost Item Details</h1>

@if (potentialMatches.Any())
{
    <div class="card border-info bg-dark text-light mb-4 shadow">
        <div class="card-header bg-info text-dark fw-bold d-flex justify-content-between align-items-center">
            <span>AI Potential Matches Found in Inventory (@potentialMatches.Count)</span>
            <span class="badge bg-dark text-info">Smart Match</span>
        </div>
        <div class="card-body">
            <p class="small text-light text-opacity-75 mb-3">
                Our AI matched this lost report against currently unclaimed items turned in around campus:
            </p>
            <div class="row row-cols-1 row-cols-md-3 g-3">
                @foreach (var match in potentialMatches)
                {
                    <div class="col">
                        <div class="card h-100 bg-body-tertiary border-secondary">
                            @if (!string.IsNullOrEmpty(match.ImagePath))
                            {
                                <img src="@match.ImagePath" alt="@match.ItemName"
                                     class="card-img-top border-bottom border-secondary"
                                     style="height: 140px; object-fit: cover;" />
                            }
                            <div class="card-body p-3 d-flex flex-column">
                                <h6 class="card-title mb-1">@match.ItemName</h6>
                                <p class="card-text small text-muted flex-grow-1 mb-2">@match.Description</p>
                                <div class="small text-muted mb-2">
                                    <strong>Found at:</strong> @match.LocationFound
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="FoundItems" asp-action="Details" asp-route-id="@match.Id" class="btn btn-sm btn-outline-info">View</a>
                                    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="ClaimRequests" asp-action="Create" asp-route-foundItemId="@match.Id" class="btn btn-sm btn-success">Claim</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div>
    <h4>@Model.Title</h4>
    <hr />
    <div class="row">
        <div class="col-md-7">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Title)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Title)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Description)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Description)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Location)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Location)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.DateLost)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.DateLost)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ContactInfo)
                </dt>
                <dd class="col-sm-8">
                    @if (User.IsInRole("Admin"))
                    {
                        @Html.DisplayFor(model => model.ContactInfo)
                    }
                    else
                    {
                        <span class="badge bg-secondary">Protected — Visible to Campus Admin Only</span>
                    }
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Status)
                </dt>
                <dd class="col-sm-8">
                    @if (Model.Status == "Found" || Model.Status == "Resolved")
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="card">
                    <div class="card-header">Item Photo</div>
                    <div class="card-body text-center">
                        <img src="@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded" style="max-height: 300px;" />
                    </div>
                </div>
            }
            else
            {
                <div class="border rounded p-4 text-center text-body-secondary">
                    No photo uploaded for this item.
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>