@model IEnumerable<ReFound.Models.LostItemReport>

@{
    ViewData["Title"] = "Lost Item Reports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Lost Item Reports</h1>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" class="btn btn-primary">+ Report Lost Item</a>
    }
</div>

<div class="mb-4">
    <input type="text" id="searchBox" class="form-control form-control-lg"
           placeholder="Search lost items by title, description, or location..." />
</div>

<div id="reportCards" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col searchable-card">
            <div class="card h-100 bg-dark text-light border-secondary shadow-sm">
                <div class="position-relative">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="@item.Title"
                             class="card-img-top border-bottom border-secondary"
                             style="height: 210px; object-fit: cover;"
                             onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none'); this.nextElementSibling.classList.add('d-flex');" />
                        <div class="d-none align-items-center justify-content-center bg-secondary bg-opacity-25 border-bottom border-secondary text-muted"
                             style="height: 210px;">
                            <span>No Photo Available</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary bg-opacity-25 border-bottom border-secondary text-muted"
                             style="height: 210px;">
                            <span>No Photo Available</span>
                        </div>
                    }

                    <div class="position-absolute top-0 end-0 m-2">
                        @if (item.Status == "Found" || item.Status == "Resolved")
                        {
                            <span class="badge bg-success shadow-sm">@item.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark shadow-sm">@item.Status</span>
                        }
                    </div>
                </div>

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title item-title mb-2">@Html.DisplayFor(modelItem => item.Title)</h5>

                    <p class="card-text text-light text-opacity-75 small flex-grow-1 item-desc">
                        @Html.DisplayFor(modelItem => item.Description)
                    </p>

                    <div class="small text-muted border-top border-secondary pt-2 mt-2">
                        <div class="item-loc"><strong>Last Seen:</strong> @Html.DisplayFor(modelItem => item.Location)</div>
                        <div><strong>Date Lost:</strong> @Html.DisplayFor(modelItem => item.DateLost)</div>
                        <div>
                            <strong>Contact:</strong>
                            @if (User.IsInRole("Admin"))
                            {
                                @Html.DisplayFor(modelItem => item.ContactInfo)
                            }
                            else
                            {
                                <span class="fst-italic">Protected (Contact via Campus Admin)</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-transparent border-secondary d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning ms-auto">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.getElementById("searchBox").addEventListener("input", function () {
        const text = this.value.toLowerCase();

        document.querySelectorAll("#reportCards .searchable-card").forEach(function (card) {
            const title = card.querySelector(".item-title")?.textContent || "";
            const desc = card.querySelector(".item-desc")?.textContent || "";
            const loc = card.querySelector(".item-loc")?.textContent || "";
            const cardText = (title + " " + desc + " " + loc).toLowerCase();

            card.style.display = cardText.includes(text) ? "" : "none";
        });
    });
</script>
}